{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skywatcher.local/schemas/replay/telemetry-v1.schema.json",
  "title": "Skywatcher replay telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observation_id", "stream_id", "observed_at_utc", "observed_at_epoch_ms", "time_basis", "time_uncertainty_ms", "quality", "observed", "interpolated", "canonical_table", "canonical_record_id", "provenance_ref"],
  "properties": {
    "schema": {"const": "skywatcher.telemetry.v1"},
    "observation_id": {"type": "string", "minLength": 1},
    "stream_id": {"type": "string", "minLength": 1},
    "sensor_id": {"type": ["string", "null"]},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "observed_at_epoch_ms": {"type": "integer"},
    "source_timestamp_raw": {"type": ["string", "null"]},
    "source_timezone": {"type": ["string", "null"]},
    "received_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "ingested_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "time_basis": {"enum": ["gps", "ntp", "provider", "embedded", "filename", "ocr", "operator", "inferred", "synthetic"]},
    "time_uncertainty_ms": {"type": ["integer", "null"], "minimum": 0},
    "clock_correction_ms": {"type": "integer", "default": 0},
    "clock_correction_method": {"type": ["string", "null"]},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "quality": {"enum": ["accepted", "provisional", "degraded", "rejected", "unknown", "synthetic"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "observed": {"type": "boolean"},
    "interpolated": {"type": "boolean"},
    "source_artifact_id": {"type": ["string", "null"]},
    "canonical_table": {"type": "string", "minLength": 1},
    "canonical_record_id": {"type": "string", "minLength": 1},
    "processing_run_id": {"type": ["integer", "null"]},
    "provenance_ref": {"type": "string", "minLength": 1},
    "attributes": {"type": "object"}
  },
  "allOf": [{"not": {"properties": {"observed": {"const": true}, "interpolated": {"const": true}}, "required": ["observed", "interpolated"]}}]
}
