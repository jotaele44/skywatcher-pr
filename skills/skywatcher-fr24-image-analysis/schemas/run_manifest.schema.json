{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FR24 Image Analysis Run Manifest",
  "type": "object",
  "required": ["run_id", "mode", "sources", "stage_1", "stage_2", "correlation"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^SWFR24-[A-F0-9]{16}$"},
    "mode": {"enum": ["triage", "standard", "forensic"]},
    "sources": {"type": "array", "minItems": 1},
    "stage_1": {"$ref": "#/$defs/stage"},
    "stage_2": {"$ref": "#/$defs/stage"},
    "correlation": {"$ref": "#/$defs/stage"},
    "deterministic_config": {"type": "object"}
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["name", "status", "frozen", "outputs", "warnings"],
      "properties": {
        "name": {"type": "string"},
        "status": {"type": "string"},
        "frozen": {"type": "boolean"},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
