{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitirre-pr.local/schemas/air_event_v2.schema.json",
  "title": "PITIRRE Air Event v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "event_id",
    "source",
    "source_tier",
    "mode",
    "observed_at",
    "lat",
    "lon",
    "geometry_status",
    "coordinate_status",
    "source_coordinates",
    "aircraft_id",
    "callsign",
    "altitude_ft",
    "speed_kt",
    "heading_deg",
    "event_type",
    "confidence",
    "tactical_public_tracking"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "event_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_tier": {"enum": ["T1", "T2", "T3", "T4"]},
    "mode": {"enum": ["delayed_or_rate_limited", "batch_file", "historical_baseline", "periodic"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "geometry_status": {"enum": ["LOCATED", "UNRESOLVED", "INVALID"]},
    "coordinate_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"enum": ["VALID", "MISSING", "INVALID"]},
        "lon": {"enum": ["VALID", "MISSING", "INVALID"]}
      }
    },
    "source_coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_lat_field",
        "selected_lon_field",
        "lat_raw",
        "latitude_raw",
        "lon_raw",
        "longitude_raw"
      ],
      "properties": {
        "selected_lat_field": {"type": ["string", "null"]},
        "selected_lon_field": {"type": ["string", "null"]},
        "lat_raw": {},
        "latitude_raw": {},
        "lon_raw": {},
        "longitude_raw": {}
      }
    },
    "aircraft_id": {"type": "string"},
    "callsign": {"type": "string"},
    "altitude_ft": {"type": "number"},
    "speed_kt": {"type": "number"},
    "heading_deg": {"type": "number", "minimum": 0, "maximum": 360},
    "event_type": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tactical_public_tracking": {"const": false}
  }
}
