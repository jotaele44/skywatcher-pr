{
  "schema_version": "prii.gui-capability/v1",
  "repository": "jotaele44/skywatcher-pr",
  "policy": {
    "mode": "ratchet",
    "baseline": ".federation/gui-parity-baseline.json",
    "require_discoverable_gui": true,
    "require_e2e": true,
    "terminal_free_user_path": true
  },
  "discovery": {
    "backend_roots": [
      "server/backend"
    ],
    "production_roots": [
      "src/skywatcher",
      "fr24",
      "desktop",
      "maintenance"
    ],
    "analysis_roots": [
      "pipeline",
      "imagery",
      "scripts",
      "tools"
    ],
    "frontend_roots": [
      "frontend/src"
    ],
    "frontend_capability_roots": [
      "frontend/src/pages"
    ],
    "frontend_api_roots": [
      "frontend/src/api",
      "frontend/src/lib/SkywatcherData.jsx"
    ],
    "route_files": [
      "frontend/src/App.jsx"
    ],
    "navigation_files": [
      "frontend/src/components/skywatcher/Sidebar.jsx"
    ],
    "implicit_routes": [],
    "exclude": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/components/ui/**",
      "scripts/check_gui_parity.py",
      "scripts/validate_flight_corpus_v4_import.py",
      "src/skywatcher/flight_corpus_v4.py"
    ]
  },
  "capabilities": [
    {
      "id": "airspace-intelligence-console",
      "classification": "analysis",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py",
          "server/backend/console/fr24_control_plane.py",
          "scripts/load_fr24_control_plane.py",
          "src/skywatcher/fr24/flight_corpus.py",
          "src/skywatcher/fr24/flight_coverage.py",
          "src/skywatcher/fr24/acquisition_receipts.py"
        ],
        "endpoints": [
          "GET /api/apps/public-settings",
          "GET /api/auth/me",
          "GET /api/entities/{entity_name}",
          "POST /api/entities/{entity_name}/filter",
          "GET /api/entities/{entity_name}/{entity_id}",
          "POST /api/entities/{entity_name}",
          "PATCH /api/entities/{entity_name}/{entity_id}",
          "GET /api/geo/observations.geojson",
          "GET /api/geo/airports.geojson",
          "GET /api/geo/infrastructure.geojson",
          "GET /api/geo/corridors.geojson",
          "GET /api/geo/observations/heatmap.geojson",
          "GET /api/geo/tracks",
          "GET /api/geo/tracks/{icao24}.geojson",
          "GET /api/geo/municipios.geojson",
          "GET /api/geo/municipios/observation_density.geojson",
          "GET /api/flight-corpus/v4/status",
          "GET /api/flight-corpus/v4/artifact-members",
          "GET /api/flight-corpus/v4/deep-interface",
          "GET /api/flight-corpus/v4/route-family-recurrence",
          "GET /api/flight-corpus/v4/airport-edge-recurrence",
          "GET /api/flight-corpus/v4/family-provenance",
          "GET /api/flight-corpus/archive/snapshots",
          "GET /api/flight-corpus/archive/snapshots/{snapshot_id}",
          "POST /api/flight-corpus/archive/snapshots",
          "GET /api/flight-corpus/archive/snapshots/{snapshot_id}/coverage",
          "GET /api/flight-acquisition/p1/status",
          "GET /api/flight-corpus/v4/family-split-summary"
        ],
        "symbols": [
          "server/backend/main.py:geo_observations",
          "server/backend/main.py:geo_airports",
          "server/backend/main.py:geo_infrastructure",
          "server/backend/main.py:geo_corridors",
          "server/backend/main.py:geo_observations_heatmap",
          "server/backend/main.py:geo_track_index",
          "server/backend/main.py:geo_track",
          "server/backend/main.py:geo_municipios",
          "server/backend/main.py:geo_municipios_observation_density",
          "server/backend/main.py:flight_corpus_v4_status",
          "server/backend/main.py:flight_corpus_v4_artifact_members",
          "server/backend/main.py:flight_corpus_v4_deep_interface",
          "server/backend/main.py:flight_corpus_v4_route_family_recurrence",
          "server/backend/main.py:flight_corpus_v4_airport_edge_recurrence",
          "server/backend/main.py:flight_corpus_v4_family_provenance",
          "server/backend/console/fr24_control_plane.py:BridgeSummary",
          "server/backend/console/fr24_control_plane.py:ingest_fr24_control_plane",
          "scripts/load_fr24_control_plane.py:main",
          "server/backend/main.py:flight_corpus_archive_snapshots",
          "server/backend/main.py:flight_corpus_archive_snapshot",
          "server/backend/main.py:flight_corpus_archive_persist",
          "src/skywatcher/fr24/flight_corpus.py:CorpusPersistenceError",
          "src/skywatcher/fr24/flight_corpus.py:PersistResult",
          "src/skywatcher/fr24/flight_corpus.py:persist_corpus_snapshot",
          "src/skywatcher/fr24/flight_corpus.py:read_corpus_snapshot",
          "server/backend/main.py:flight_corpus_archive_coverage",
          "src/skywatcher/fr24/flight_coverage.py:build_coverage_ledger",
          "server/backend/main.py:flight_acquisition_p1_status",
          "src/skywatcher/fr24/acquisition_receipts.py:AcquisitionReceiptError",
          "src/skywatcher/fr24/acquisition_receipts.py:load_manifest",
          "src/skywatcher/fr24/acquisition_receipts.py:validate_manifest",
          "src/skywatcher/fr24/acquisition_receipts.py:next_discovery_target",
          "src/skywatcher/fr24/acquisition_receipts.py:record_discovery",
          "src/skywatcher/fr24/acquisition_receipts.py:record_blocked_auth",
          "src/skywatcher/fr24/acquisition_receipts.py:export_harvest_carryover",
          "src/skywatcher/fr24/acquisition_receipts.py:status_summary",
          "server/backend/main.py:flight_corpus_v4_family_split_summary"
        ]
      },
      "frontend": {
        "routes": [
          "/",
          "/observations",
          "/aircraft",
          "/fr24",
          "/routes",
          "/infrastructure",
          "/airports",
          "/review",
          "/export",
          "/readiness",
          "/calibration",
          "/console",
          "/spatial-truth",
          "/flight-archive"
        ],
        "e2e_routes": [
          "/",
          "/observations",
          "/aircraft",
          "/fr24",
          "/routes",
          "/infrastructure",
          "/airports",
          "/review",
          "/export",
          "/readiness",
          "/calibration",
          "/console",
          "/spatial-truth",
          "/flight-archive"
        ],
        "components": [
          "frontend/src/api/federationClient.js",
          "frontend/src/lib/AuthContext.jsx",
          "frontend/src/lib/observation-density.js",
          "frontend/src/lib/SkywatcherData.jsx",
          "frontend/src/pages/Dashboard.jsx",
          "frontend/src/pages/Observations.jsx",
          "frontend/src/pages/Aircraft.jsx",
          "frontend/src/pages/FR24Intake.jsx",
          "frontend/src/pages/Routes.jsx",
          "frontend/src/pages/Infrastructure.jsx",
          "frontend/src/pages/Airports.jsx",
          "frontend/src/pages/ManualReview.jsx",
          "frontend/src/pages/ExportCenter.jsx",
          "frontend/src/pages/Readiness.jsx",
          "frontend/src/pages/Calibration.jsx",
          "frontend/src/pages/Console.jsx",
          "frontend/src/pages/SpatialTruth.jsx",
          "frontend/src/components/skywatcher/PuertoRicoMapShell.jsx",
          "frontend/src/components/skywatcher/SpatialToolsPanel.jsx",
          "frontend/src/components/skywatcher/TrackTimeScrubber.jsx",
          "frontend/src/components/skywatcher/SpatialFlightRenderer.jsx",
          "frontend/src/components/ProgramTimeline.jsx",
          "frontend/src/lib/flightIngestion.js",
          "frontend/src/pages/FlightArchive.jsx"
        ],
        "discoverability": [
          "frontend/src/components/skywatcher/Sidebar.jsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_flight_fusion_endpoints.py",
          "tests/test_manual_review_queue.py",
          "tests/test_fr24_dashboard_data.py",
          "tests/test_satim_calibration.py",
          "tests/test_geo_municipios_routes.py",
          "tests/test_fr24_control_plane_bridge.py",
          "tests/test_flight_corpus_archive_api.py",
          "tests/test_flight_corpus_persistence.py",
          "tests/test_flight_corpus_migration.py",
          "tests/test_flight_coverage.py",
          "tests/test_acquisition_receipts.py",
          "tests/test_acquisition_status_api.py"
        ],
        "contract": [
          "tests/test_gui_parity.py"
        ],
        "unit": [
          "frontend/src/lib/app-params.test.js",
          "frontend/src/components/skywatcher/PuertoRicoMapShell.test.jsx",
          "frontend/src/components/skywatcher/SpatialToolsPanel.test.jsx",
          "frontend/src/components/skywatcher/SpatialFlightRenderer.test.jsx",
          "frontend/src/lib/flightIngestion.test.js",
          "frontend/src/lib/masterFlightLog.test.js"
        ],
        "e2e": [
          "frontend/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "service-health",
      "classification": "internal",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Health probes support CI, launch diagnostics, and supervision rather than a separate user workflow.",
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /health",
          "GET /api/health"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_server_smoke.py"
        ]
      }
    }
  ],
  "exceptions": []
}
