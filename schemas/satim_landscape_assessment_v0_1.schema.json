{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skywatcher-pr.local/schemas/satim_landscape_assessment_v0_1.schema.json",
  "title": "SATIM landscape assessment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "method_version", "source", "metrics", "evidence_states",
    "competing_classes", "top_class", "terminal_state", "review_required",
    "production_promotion_authorized", "thresholds_applied", "benchmark_state",
    "benchmark_blockers", "limitations", "temporal_recurrence_support"
  ],
  "properties": {
    "schema_version": {"const": "satim.landscape.assessment.v0.1"},
    "method_version": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "path"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "width_px", "height_px", "analysis_width_px", "analysis_height_px",
        "vegetation_fraction", "forest_matrix_fraction", "open_surface_fraction",
        "exposed_soil_fraction", "bright_cover_fraction", "directional_texture_score",
        "patch_mosaic_score", "extraction_method", "extraction_constants"
      ],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "analysis_width_px": {"type": "integer", "minimum": 1},
        "analysis_height_px": {"type": "integer", "minimum": 1},
        "vegetation_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "forest_matrix_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "open_surface_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "exposed_soil_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "bright_cover_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "directional_texture_score": {"type": "number", "minimum": 0, "maximum": 1},
        "patch_mosaic_score": {"type": "number", "minimum": 0, "maximum": 1},
        "extraction_method": {"type": "string", "minLength": 1},
        "extraction_constants": {"type": "object"}
      }
    },
    "evidence_states": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "competing_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_name", "score", "evaluated", "supporting_evidence",
          "contradicting_evidence", "unevaluated_requirements"
        ],
        "properties": {
          "class_name": {"type": "string", "minLength": 1},
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "evaluated": {"type": "boolean"},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}},
          "contradicting_evidence": {"type": "array", "items": {"type": "string"}},
          "unevaluated_requirements": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "top_class": {"type": ["string", "null"]},
    "terminal_state": {"enum": ["CANDIDATE_NOT_IDENTITY", "REVIEW_UNRESOLVED", "UNRESOLVED"]},
    "review_required": {"type": "boolean"},
    "production_promotion_authorized": {"type": "boolean"},
    "thresholds_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["threshold_id", "value", "status"],
        "properties": {
          "threshold_id": {"type": "string", "minLength": 1},
          "value": {},
          "status": {"type": "string", "minLength": 1}
        }
      }
    },
    "benchmark_state": {"type": "string", "minLength": 1},
    "benchmark_blockers": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "temporal_recurrence_support": {"type": "boolean"}
  }
}
