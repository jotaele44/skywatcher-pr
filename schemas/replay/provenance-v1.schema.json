{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skywatcher.local/schemas/replay/provenance-v1.schema.json",
  "title": "Skywatcher replay provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provenance_id", "subject_id", "source_artifacts", "transformations", "integrity"],
  "properties": {
    "schema": {"const": "skywatcher.provenance.v1"},
    "provenance_id": {"type": "string", "pattern": "^prov:"},
    "subject_id": {"type": "string", "minLength": 1},
    "source_artifacts": {"type": "array", "items": {"type": "object", "required": ["artifact_id", "sha256"], "properties": {"artifact_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}},
    "transformations": {"type": "array", "items": {"type": "object"}},
    "review": {"type": ["object", "null"]},
    "integrity": {"type": "object", "required": ["complete"], "properties": {"complete": {"type": "boolean"}, "canonical_record_digest": {"type": ["string", "null"]}}, "additionalProperties": false}
  }
}
