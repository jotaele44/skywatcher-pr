{
  "schema_version": "prii.gui-capability/v1",
  "repository": "jotaele44/skywatcher-pr",
  "policy": {
    "mode": "ratchet",
    "baseline": ".federation/gui-parity-baseline.json",
    "require_discoverable_gui": true,
    "require_e2e": true,
    "terminal_free_user_path": true
  },
  "discovery": {
    "backend_roots": [
      "server/backend"
    ],
    "production_roots": [
      "src/skywatcher",
      "fr24",
      "desktop",
      "maintenance"
    ],
    "analysis_roots": [
      "pipeline",
      "imagery",
      "scripts",
      "tools"
    ],
    "frontend_roots": [
      "frontend/src"
    ],
    "frontend_capability_roots": [
      "frontend/src/pages"
    ],
    "frontend_api_roots": [
      "frontend/src/api",
      "frontend/src/lib/SkywatcherData.jsx"
    ],
    "route_files": [
      "frontend/src/App.jsx"
    ],
    "navigation_files": [
      "frontend/src/components/skywatcher/Sidebar.jsx"
    ],
    "implicit_routes": [],
    "exclude": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/components/ui/**",
      "scripts/check_gui_parity.py"
    ]
  },
  "capabilities": [
    {
      "id": "airspace-intelligence-console",
      "classification": "analysis",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /api/apps/public-settings",
          "GET /api/auth/me",
          "GET /api/entities/{entity_name}",
          "POST /api/entities/{entity_name}/filter",
          "GET /api/entities/{entity_name}/{entity_id}",
          "POST /api/entities/{entity_name}",
          "PATCH /api/entities/{entity_name}/{entity_id}",
          "GET /api/geo/observations.geojson",
          "GET /api/geo/airports.geojson",
          "GET /api/geo/infrastructure.geojson",
          "GET /api/geo/corridors.geojson",
          "GET /api/geo/observations/heatmap.geojson",
          "GET /api/geo/tracks",
          "GET /api/geo/tracks/{icao24}.geojson",
          "GET /api/geo/municipios.geojson",
          "GET /api/geo/municipios/observation_density.geojson"
        ],
        "symbols": [
          "server/backend/main.py:geo_observations",
          "server/backend/main.py:geo_airports",
          "server/backend/main.py:geo_infrastructure",
          "server/backend/main.py:geo_corridors",
          "server/backend/main.py:geo_observations_heatmap",
          "server/backend/main.py:geo_track_index",
          "server/backend/main.py:geo_track",
          "server/backend/main.py:geo_municipios",
          "server/backend/main.py:geo_municipios_observation_density"
        ]
      },
      "frontend": {
        "routes": [
          "/",
          "/observations",
          "/aircraft",
          "/fr24",
          "/routes",
          "/infrastructure",
          "/airports",
          "/review",
          "/export",
          "/readiness",
          "/calibration",
          "/console",
          "/spatial-truth"
        ],
        "e2e_routes": [
          "/",
          "/observations",
          "/aircraft",
          "/fr24",
          "/routes",
          "/infrastructure",
          "/airports",
          "/review",
          "/export",
          "/readiness",
          "/calibration",
          "/console",
          "/spatial-truth"
        ],
        "components": [
          "frontend/src/api/federationClient.js",
          "frontend/src/lib/AuthContext.jsx",
          "frontend/src/lib/observation-density.js",
          "frontend/src/lib/SkywatcherData.jsx",
          "frontend/src/pages/Dashboard.jsx",
          "frontend/src/pages/Observations.jsx",
          "frontend/src/pages/Aircraft.jsx",
          "frontend/src/pages/FR24Intake.jsx",
          "frontend/src/pages/Routes.jsx",
          "frontend/src/pages/Infrastructure.jsx",
          "frontend/src/pages/Airports.jsx",
          "frontend/src/pages/ManualReview.jsx",
          "frontend/src/pages/ExportCenter.jsx",
          "frontend/src/pages/Readiness.jsx",
          "frontend/src/pages/Calibration.jsx",
          "frontend/src/pages/Console.jsx",
          "frontend/src/pages/SpatialTruth.jsx",
          "frontend/src/components/skywatcher/PuertoRicoMapShell.jsx",
          "frontend/src/components/skywatcher/SpatialToolsPanel.jsx",
          "frontend/src/components/skywatcher/TrackTimeScrubber.jsx"
        ],
        "discoverability": [
          "frontend/src/components/skywatcher/Sidebar.jsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_flight_fusion_endpoints.py",
          "tests/test_manual_review_queue.py",
          "tests/test_fr24_dashboard_data.py",
          "tests/test_satim_calibration.py",
          "tests/test_geo_municipios_routes.py"
        ],
        "contract": [
          "tests/test_gui_parity.py"
        ],
        "unit": [
          "frontend/src/lib/app-params.test.js",
          "frontend/src/components/skywatcher/PuertoRicoMapShell.test.jsx",
          "frontend/src/components/skywatcher/SpatialToolsPanel.test.jsx"
        ],
        "e2e": [
          "frontend/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "service-health",
      "classification": "internal",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Health probes support CI, launch diagnostics, and supervision rather than a separate user workflow.",
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /health",
          "GET /api/health"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_server_smoke.py"
        ]
      }
    },
    {
      "id": "ilap-visual-review",
      "classification": "analysis",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /api/ilap/review",
          "POST /api/entities/ILAPReviewAnnotations"
        ]
      },
      "frontend": {
        "routes": [
          "/ilap-review"
        ],
        "e2e_routes": [
          "/ilap-review"
        ],
        "components": [
          "frontend/src/api/federationClient.js",
          "frontend/src/pages/ILAPReviewLab.jsx",
          "frontend/src/components/skywatcher/IlapAnnotationPalette.jsx",
          "frontend/src/components/skywatcher/TemporalImageStackViewer.jsx",
          "frontend/src/components/skywatcher/CandidateExplainabilityPane.jsx",
          "frontend/src/components/skywatcher/MultiAnalystComparison.jsx"
        ],
        "discoverability": [
          "frontend/src/components/skywatcher/Sidebar.jsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_ilap_review_api.py"
        ],
        "contract": [
          "tests/test_gui_parity.py"
        ],
        "e2e": [
          "frontend/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "source-adapter-acquisition-internals",
      "classification": "internal",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Source-adapter discovery, rights enforcement, payload validation, certified fetching, provider registry, manifest generation, and coverage summarization are acquisition/provenance machinery. They support user-facing analysis but are not standalone GUI workflows; CLI entry points remain implementation interfaces.",
      "analysis": {
        "files": [
          "scripts/source_adapters/noaa_maria_2017/adapter.py",
          "scripts/source_adapters/provider_registry.py",
          "scripts/source_adapters/sdk/core.py",
          "scripts/source_adapters/sdk/download.py",
          "scripts/source_adapters/sdk/manifest.py"
        ],
        "symbols": [
          "scripts/source_adapters/noaa_maria_2017/adapter.py:MariaItem",
          "scripts/source_adapters/noaa_maria_2017/adapter.py:UrlListDenominator",
          "scripts/source_adapters/noaa_maria_2017/adapter.py:parse_stac_items",
          "scripts/source_adapters/noaa_maria_2017/adapter.py:parse_url_list",
          "scripts/source_adapters/noaa_maria_2017/adapter.py:build_dry_run",
          "scripts/source_adapters/noaa_maria_2017/adapter.py:build_payload_requests",
          "scripts/source_adapters/provider_registry.py:PROVIDERS",
          "scripts/source_adapters/sdk/core.py:AcquisitionRights",
          "scripts/source_adapters/sdk/core.py:AdapterPolicy",
          "scripts/source_adapters/sdk/core.py:PayloadRequest",
          "scripts/source_adapters/sdk/core.py:require_redistribution_eligible",
          "scripts/source_adapters/sdk/core.py:require_training_eligible",
          "scripts/source_adapters/sdk/download.py:CertifiedFetchResult",
          "scripts/source_adapters/sdk/download.py:CoverageSummary",
          "scripts/source_adapters/sdk/download.py:PayloadValidator",
          "scripts/source_adapters/sdk/download.py:CertifiedFetchEngine",
          "scripts/source_adapters/sdk/manifest.py:build_manifest_rows",
          "scripts/source_adapters/sdk/manifest.py:write_manifest_csv",
          "scripts/source_adapters/sdk/manifest.py:summarize_coverage"
        ]
      },
      "tests": {
        "contract": [
          "tests/test_skywatcher_source_adapter_sdk.py",
          "tests/test_gui_parity.py"
        ]
      }
    }
  ],
  "exceptions": []
}
