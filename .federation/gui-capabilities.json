  "discovery": {
    "backend_roots": [
      "server/backend"
    ],
    "production_roots": [
      "src/skywatcher",
      "fr24",
      "desktop",
      "maintenance"
    ],
    "analysis_roots": [
      "pipeline",
      "imagery",
      "scripts",
      "tools"
    ],
    "frontend_roots": [
      "frontend/src"
    ],
    "frontend_capability_roots": [
      "frontend/src/pages"
    ],
    "frontend_api_roots": [
      "frontend/src/api",
      "frontend/src/lib/SkywatcherData.jsx"
