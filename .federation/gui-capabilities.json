{
  "schema_version": "prii.gui-capability/v1",
  "repository": "jotaele44/skywatcher-pr",
  "policy": {
    "mode": "ratchet",
    "baseline": ".federation/gui-parity-baseline.json",
    "require_discoverable_gui": true,
    "require_e2e": true,
    "terminal_free_user_path": true
  },
  "discovery": {
    "backend_roots": [
      "server/backend"
    ],
    "production_roots": [
      "src/skywatcher",
      "fr24",
      "desktop",
      "maintenance"
    ],
    "analysis_roots": [
      "pipeline",
      "imagery",
      "scripts",
      "tools"
    ],
    "frontend_roots": [
      "frontend/src"
    ],
    "frontend_capability_roots": [
      "frontend/src/pages"
    ],
    "frontend_api_roots": [
      "frontend/src/api",
      "frontend/src/lib/SkywatcherData.jsx"
    ],
    "route_files": [
      "frontend/src/App.jsx"
    ],
    "navigation_files": [
      "frontend/src/components/skywatcher/Sidebar.jsx",
      "frontend/src/components/skywatcher/Layout.jsx"
    ],
    "implicit_routes": [],
    "exclude": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/components/ui/**",
      "scripts/check_gui_parity.py"
    ]
  },
  "capabilities": [
    {
      "id": "airspace-intelligence-console",
      "classification": "analysis",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /api/apps/public-settings",
          "GET /api/auth/me",
          "GET /api/entities/{entity_name}",
          "POST /api/entities/{entity_name}/filter",
          "GET /api/entities/{entity_name}/{entity_id}",
          "POST /api/entities/{entity_name}",
          "PATCH /api/entities/{entity_name}/{entity_id}"
        ]
      },
      "frontend": {
        "routes": [
          "/",
          "/observations",
          "/aircraft",
          "/fr24",
          "/routes",
          "/infrastructure",
          "/airports",
          "/review",
          "/export",
          "/readiness",
          "/calibration",
          "/console",
          "/analysis",
          "/spatial-truth"
        ],
        "e2e_routes": [
          "/",
          "/observations",
          "/aircraft",
          "/fr24",
          "/routes",
          "/infrastructure",
          "/airports",
          "/review",
          "/export",
          "/readiness",
          "/calibration",
          "/console",
          "/analysis",
          "/spatial-truth"
        ],
        "components": [
          "frontend/src/api/federationClient.js",
          "frontend/src/lib/AuthContext.jsx",
          "frontend/src/lib/SkywatcherData.jsx",
          "frontend/src/pages/Dashboard.jsx",
          "frontend/src/pages/Observations.jsx",
          "frontend/src/pages/Aircraft.jsx",
          "frontend/src/pages/FR24Intake.jsx",
          "frontend/src/pages/Routes.jsx",
          "frontend/src/pages/Infrastructure.jsx",
          "frontend/src/pages/Airports.jsx",
          "frontend/src/pages/ManualReview.jsx",
          "frontend/src/pages/ExportCenter.jsx",
          "frontend/src/pages/Readiness.jsx",
          "frontend/src/pages/Calibration.jsx",
          "frontend/src/components/skywatcher/ReviewActions.jsx",
          "frontend/src/components/skywatcher/drawers/ReviewDetailDrawer.jsx",
          "frontend/src/components/skywatcher/drawers/CaptureDetailDrawer.jsx",
          "frontend/src/lib/browser-storage.js",
          "frontend/src/components/skywatcher/Layout.jsx",
          "frontend/src/pages/Console.jsx",
          "frontend/src/pages/AnalysisLenses.jsx",
          "frontend/src/pages/SpatialTruth.jsx",
          "frontend/src/components/skywatcher/SideDrawer.jsx",
          "frontend/src/components/skywatcher/MetricCard.jsx",
          "frontend/src/components/skywatcher/PageHeader.jsx",
          "frontend/src/components/skywatcher/Panel.jsx",
          "frontend/src/components/skywatcher/StatusChip.jsx",
          "frontend/src/components/skywatcher/EmptyState.jsx",
          "frontend/src/components/skywatcher/HourlyObservationsChart.jsx",
          "frontend/src/components/skywatcher/drawers/DrawerHub.jsx",
          "frontend/src/App.jsx",
          "frontend/src/pages/Login.jsx",
          "frontend/src/pages/ForgotPassword.jsx"
        ],
        "discoverability": [
          "frontend/src/components/skywatcher/Sidebar.jsx",
          "frontend/src/components/skywatcher/Layout.jsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_flight_fusion_endpoints.py",
          "tests/test_manual_review_queue.py",
          "tests/test_fr24_dashboard_data.py",
          "tests/test_satim_calibration.py"
        ],
        "contract": [
          "tests/test_gui_parity.py"
        ],
        "e2e": [
          "frontend/tests/gui-parity.spec.mjs",
          "frontend/tests/zip-design.spec.mjs"
        ],
        "unit": [
          "frontend/src/lib/SkywatcherData.test.jsx",
          "frontend/src/lib/browser-storage.test.js",
          "frontend/src/components/skywatcher/ReviewActions.test.jsx",
          "frontend/src/lib/federation-types.test.js",
          "frontend/src/api/federationClient.test.js",
          "frontend/src/components/skywatcher/CommandReferenceCard.test.jsx"
        ]
      }
    },
    {
      "id": "service-health",
      "classification": "internal",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Health probes support CI, launch diagnostics, and supervision rather than a separate user workflow.",
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /health",
          "GET /api/health"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_server_smoke.py"
        ]
      }
    },
    {
      "id": "fusion-input-validation",
      "classification": "internal",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Validation and candidate bookkeeping inside existing batch fusion calculations; no new operator command or workflow. Proximity remains discovery, not identity.",
      "backend": {
        "files": [
          "src/skywatcher/fusion/coastal_corridor_index.py",
          "src/skywatcher/fusion/cross_domain_overlap.py",
          "src/skywatcher/fusion/anomaly_scoring.py",
          "src/skywatcher/fr24/screenshot_source.py",
          "src/skywatcher/satim/landscape/benchmark.py"
        ],
        "symbols": [
          "src/skywatcher/fusion/coastal_corridor_index.py:finite_number"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_pr_corridor_attachment.py",
          "tests/test_cross_domain_overlap.py",
          "tests/test_sensor_fusion_policy_guards.py"
        ]
      }
    },
    {
      "id": "local-repair-validation",
      "classification": "internal",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Developer and CI validation infrastructure only; executes explicitly configured test commands, preserves receipts, and never supplies a production operator workflow or certification.",
      "backend": {
        "files": [
          "maintenance/repair_runner.py"
        ],
        "symbols": [
          "maintenance/repair_runner.py:digest",
          "maintenance/repair_runner.py:canonical",
          "maintenance/repair_runner.py:snapshot",
          "maintenance/repair_runner.py:write_json",
          "maintenance/repair_runner.py:run_plan",
          "maintenance/repair_runner.py:main",
          "maintenance/repair_runner.py:fingerprints"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_repair_runner.py"
        ]
      }
    },
    {
      "id": "command-reference-copy",
      "classification": "client_only",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Copies displayed reference text using the browser clipboard; does not execute commands or mutate backend state. Failure exposes manual selection and retry.",
      "frontend": {
        "routes": [
          "/export"
        ],
        "e2e_routes": [
          "/export"
        ],
        "components": [
          "frontend/src/components/skywatcher/CommandReferenceCard.jsx"
        ],
        "discoverability": [
          "frontend/src/pages/ExportCenter.jsx",
          "frontend/src/components/skywatcher/Sidebar.jsx"
        ]
      },
      "tests": {
        "unit": [
          "frontend/src/components/skywatcher/CommandReferenceCard.test.jsx"
        ],
        "e2e": [
          "frontend/tests/zip-design.spec.mjs",
          "frontend/tests/gui-parity.spec.mjs"
        ]
      }
    }
  ],
  "exceptions": []
}
