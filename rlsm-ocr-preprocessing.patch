-        out.append({"t": text, "x": x + x_off, "y": y + y_off,
-                    "w": w, "h": h, "c": round(conf, 1)})
+        out.append({"t": text,
+                    "x": int(x / sc) + x_off, "y": int(y / sc) + y_off,
+                    "w": int(w / sc), "h": int(h / sc),
