{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/skywatcher-pr/schemas/sky_camera.schema.json",
  "title": "Sky Cameras catalog (skywatcher.sky-cameras/v1)",
  "description": "Curated catalog of publicly available live cameras in Puerto Rico. Read by src/skywatcher/core/cameras/catalog.py.",
  "type": "object",
  "required": ["schema", "cameras"],
  "properties": {
    "schema": {"const": "skywatcher.sky-cameras/v1"},
    "description": {"type": "string"},
    "cameras": {"type": "array", "items": {"$ref": "#/$defs/camera"}}
  },
  "$defs": {
    "https_url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048},
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "categories", "municipality", "lat", "lon", "provider",
        "page_url", "embed", "terms_note", "source_url", "verified_at",
        "last_known_status", "added_by"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["sky", "beach", "coast", "mountain", "river", "lake", "lagoon", "city"]}
        },
        "municipality": {"type": "string", "description": "One of the 78 names in data/geo/pr_municipios_boundaries.json."},
        "lat": {"type": "number", "minimum": 17.8, "maximum": 18.6},
        "lon": {"type": "number", "minimum": -67.95, "maximum": -65.2},
        "provider": {"type": "string", "minLength": 1, "maxLength": 120},
        "page_url": {"$ref": "#/$defs/https_url"},
        "embed": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "video_id"],
              "properties": {
                "kind": {"enum": ["youtube", "vimeo"]},
                "video_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{6,20}$"}
              }
            }
          ]
        },
        "terms_note": {"type": "string", "maxLength": 500},
        "source_url": {"$ref": "#/$defs/https_url"},
        "verified_at": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "last_known_status": {"enum": ["online", "offline", "unknown"]},
        "added_by": {"enum": ["curated", "community"]}
      }
    }
  }
}
