{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skywatcher-pr.local/schemas/sky_event.schema.json",
  "title": "Skywatcher Sky Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sky_event_id",
    "event_type",
    "identity_state",
    "source_id",
    "source_url_raw",
    "source_url_canonical",
    "retrieved_utc",
    "classification_state"
  ],
  "properties": {
    "sky_event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["meteor","fireball","bolide","rocket_launch","rocket_stage","spacecraft_pass","spacecraft_breakup","satellite_pass","reentry","asteroid_neo","comet","planetary","lunar","stellar","eclipse","occultation","other"]},
    "object_id": {"type": ["string","null"]},
    "object_name_raw": {"type": ["string","null"]},
    "object_type": {"type": ["string","null"]},
    "identity_state": {"enum": ["CONFIRMED_OBJECT","CONFIRMED_EVENT","LIKELY_ASSOCIATION","CANDIDATE","CONTRADICTED","UNRESOLVED"]},
    "start_utc": {"type": ["string","null"], "format": "date-time"},
    "end_utc": {"type": ["string","null"], "format": "date-time"},
    "time_local_raw": {"type": ["string","null"]},
    "timezone": {"type": ["string","null"]},
    "location_raw": {"type": ["string","null"]},
    "latitude": {"type": ["number","null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number","null"], "minimum": -180, "maximum": 180},
    "view_direction_raw": {"type": ["string","null"]},
    "azimuth_min_deg": {"type": ["number","null"], "minimum": 0, "maximum": 360},
    "azimuth_max_deg": {"type": ["number","null"], "minimum": 0, "maximum": 360},
    "movement_direction_raw": {"type": ["string","null"]},
    "duration_raw": {"type": ["string","null"]},
    "prediction_status": {"enum": ["PREDICTED","OBSERVED","POST_EVENT_IDENTIFICATION","SCIENTIFIC_INTERPRETATION","UNKNOWN"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_title_raw": {"type": ["string","null"]},
    "source_author_raw": {"type": ["string","null"]},
    "published_raw": {"type": ["string","null"]},
    "source_url_raw": {"type": "string", "format": "uri"},
    "source_url_canonical": {"type": "string", "format": "uri"},
    "retrieved_utc": {"type": "string", "format": "date-time"},
    "raw_sha256": {"type": ["string","null"], "pattern": "^[a-f0-9]{64}$"},
    "logical_sha256": {"type": ["string","null"], "pattern": "^[a-f0-9]{64}$"},
    "upstream_identifiers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "classification_state": {"enum": ["MATCHED","PARTIAL","CONTRADICTED","UNRESOLVED","NOT_CORRELATED"]},
    "notes": {"type": ["string","null"]}
  }
}