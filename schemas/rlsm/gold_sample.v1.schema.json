{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skywatcher.local/schemas/rlsm/gold_sample.v1.schema.json",
  "title": "Skywatcher RLSM Gold Sample Record v1",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {"required": ["screenshot_id"]},
    {"required": ["screenshot_sha256"]},
    {"required": ["filename"]}
  ],
  "properties": {
    "screenshot_id": {"type": "integer", "minimum": 1},
    "screenshot_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "filename": {"type": "string", "minLength": 1},
    "frame_type": {
      "type": "string",
      "enum": [
        "fr24_selected_flight",
        "fr24_map",
        "earth_or_maps",
        "map_or_other",
        "unknown"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [{"required": ["text"]}, {"required": ["label"]}],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "bbox": {
                "type": "array",
                "prefixItems": [
                  {"type": "number"},
                  {"type": "number"},
                  {"type": "number", "exclusiveMinimum": 0},
                  {"type": "number", "exclusiveMinimum": 0}
                ],
                "items": false
              },
              "kind": {"type": "string"},
              "linked_object": {"type": ["string", "null"]}
            }
          }
        ]
      }
    },
    "aircraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registration": {"type": ["string", "null"]},
        "callsign": {"type": ["string", "null"]},
        "aircraft_type": {"type": ["string", "null"]},
        "altitude_ft": {"type": ["integer", "null"]},
        "speed_kt": {"type": ["integer", "null"]},
        "heading_deg": {"type": ["integer", "null"], "minimum": 0, "maximum": 360},
        "operator": {"type": ["string", "null"]}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path_shape": {
          "type": "string",
          "enum": ["linear", "curved", "loop", "multi_loop", "orbit", "stationary_or_unknown"]
        },
        "visible": {"type": "boolean"},
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "items": false
        }
      }
    },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bbox"],
        "properties": {
          "class": {"type": ["string", "null"]},
          "bbox": {
            "type": "array",
            "prefixItems": [
              {"type": "number"},
              {"type": "number"},
              {"type": "number", "exclusiveMinimum": 0},
              {"type": "number", "exclusiveMinimum": 0}
            ],
            "items": false
          }
        }
      }
    },
    "annotator": {"type": "string"},
    "reviewed_by": {"type": "string"},
    "notes": {"type": "string"}
  }
}
